# ==============================================================================
# CreditGate FCC TEE Handler — Example Environment Configuration
#
# Home of the Python handler that runs inside a real TEE (GCP Confidential Space
# / Intel TDX). Following the flare-ai-kit convention: prefixes separate the
# GCP-confidential-space config (`GCP__*`) from the runtime-in-the-enclave
# config (`TEE__*`, `FLARE__*`, `VAULT__*`, `CREDITGATE__*`).
#
# INSTRUCTIONS:
#   1. Copy this file to .env:        cp .env.example .env
#   2. Fill in the values
#   3. Do NOT commit .env (it's gitignored). DO commit changes to this .env.example.
#   4. Run:                          ./deploy-tee.sh
#
# Every variable is passed through gcloud --metadata tee-env-* so it lands inside
# the enclave on boot.
# ==============================================================================


# ──────────────────────────────────────────────────────────────────────────────
# GCP CONFIDENTIAL SPACE DEPLOY CONFIGURATION
# These mirror the flare-ai-kit .env.example but pin to CreditGate values.
# https://cloud.google.com/confidential-computing/confidential-space/docs/confidential-space-overview
# ──────────────────────────────────────────────────────────────────────────────

# VM instance name (shows up in gcloud compute instances list)
GCP__INSTANCE_NAME=creditgate-fcc-tee

# GCP project ID. https://console.cloud.google.com/
GCP__PROJECT=your-gcp-project-id

# GCP zone — must be a Confidential Space-compatible zone.
# us-central1-a supports both Intel TDX (C3) and AMD SEV (N2D/C2D/C3D/C4D).
GCP__ZONE=us-central1-a

# Machine type — Intel C3 series supports TDX. c3-standard-4 is the smallest
# recommended Confidential Space node.
GCP__MACHINE_TYPE=c3-standard-4

# Service account the Confidential Space instance runs as. Needs:
#   - roles/monitoring.metricWriter
#   - roles/logging.logWriter
#   (Cloud KMS / Secret Manager access only if you fetch the key from there)
GCP__SERVICE_ACCOUNT=confidential-sa@your-gcp-project-id.iam.gserviceaccount.com

# Full path of the Docker image in Artifact Registry. Format:
#   <region>-docker.pkg.dev/<project>/<repo>/<image-name>
# Repo `creditgate` must already exist (one-time):
#   gcloud artifacts repositories create creditgate \
#     --repository-format=docker --location=us-central1
GCP__TEE_IMAGE_REFERENCE=us-central1-docker.pkg.dev/your-gcp-project-id/creditgate/fcc-tee

# Confidential Space base image. Use `family/confidential-space-debug` for
# development (logs to serial port), `family/confidential-space` in production.
GCP__CONFIDENTIAL_IMAGE=family/confidential-space-debug

# Redirect container stdout/stderr to the serial port so we can read boot logs.
# (true for dev; false in production.)
GCP__TEE_CONTAINER_LOG_REDIRECT=true

# Confidential compute type — Intel TDX exploits modern C3 nodes.
# Alternatives: `SEV` (AMD SEV-SNP, available on N2D/C2D/C3D/C4D).
GCP__CONFIDENTIAL_COMPUTE_TYPE=TDX

# GCP scopes granted to the service account inside the enclave.
GCP__SCOPES=https://www.googleapis.com/auth/cloud-platform

# Network tags for firewall rules.
GCP__TAGS=creditgate,http-server,https-server


# ──────────────────────────────────────────────────────────────────────────────
# FLARE BLOCKCHAIN — chain connection from inside the TEE
# Confidential Space can egress to public HTTPS endpoints like the Flare RPC.
# ──────────────────────────────────────────────────────────────────────────────

# Coston2 testnet RPC (chain id 114).
FLARE__RPC_URL=https://coston2-api.flare.network/ext/C/rpc
# Flare mainnet (chain id 14):
# FLARE__RPC_URL=https://flare-api.flare.network/ext/C/rpc

# Block explorer (for the optional indexer pass).
# FLARE__BLOCK_EXPLORER_URL=https://coston2-explorer.flare.network/api

# Is deploy against Coston2 testnet? (true for hackathon, false for mainnet)
FLARE__IS_TESTNET=true


# ──────────────────────────────────────────────────────────────────────────────
# CREDITGATEVAULT CONTRACT — the contract we call from inside the TEE
# ──────────────────────────────────────────────────────────────────────────────

# Live CreditGateVault deployment on Coston2 (2026-08-07).
VAULT__ADDRESS=0x5e74d0a48f6b903b1b1d369e93b2fb9ca6a99939

# EVM address whose `getBorrowerReputation` we read in evaluate_credit().
# This is the borrower whose instruction triggered the EVALUATE — it's supplied
# per-action inside the instruction payload, but we keep a default here for
# smoke tests.
VAULT__SAMPLE_BORROWER=0x0000000000000000000000000000000000000001


# ──────────────────────────────────────────────────────────────────────────────
# TEE SIGNING KEY ⚠️ DO NOT COMMIT A REAL KEY HERE
#
# Two mutually-exclusive modes:
#
#   SIMULATED_TEE (dev):   CREDITGATE__SIGNING_KEY = <hex private key>
#                          The handler uses this key. Address must match the
#                          vault's teeAuthority(). Useful for local testing.
#
#   TEE ENCLAVE (prod):    CREDITGATE__SIGNING_KEY =        (leave empty)
#                          The handler calls secrets.token_bytes(32) inside
#                          the Confidential Space enclave to mint a fresh key
#                          that NEVER leaves the TEE. The derived authority
#                          address is published in /state and must be
#                          registered with the vault via setTeeAuthority().
#
# Leave blank for production TEE deployment.
# ──────────────────────────────────────────────────────────────────────────────
CREDITGATE__SIGNING_KEY=

# Reject boot outside a real TEE? Set to `true` in production deployments so a
# misconfigured launch surfaces immediately. Defaults to `false` for dev.
TEE__REQUIRE_TEE=false

# Fetch & log the GCP attestation token at boot? Set to `true` to surface
# the enclave's cryptographic attestation in the boot logs (otherwise the
# token is only available via the metadata endpoint inside the enclave).
TEE__FETCH_ATTESTATION_TOKEN=false

# Use a pregenerated attestation token for local testing (no TEE required).
TEE__SIMULATE_ATTESTATION_TOKEN=true


# ──────────────────────────────────────────────────────────────────────────────
# HTTP SERVER — listened to inside the enclave
# ──────────────────────────────────────────────────────────────────────────────
PORT=8080

# Logging level inside the enclave (DEBUG/INFO/WARNING/ERROR/CRITICAL)
LOG_LEVEL=INFO
