# CreditGate — Environment Configuration
# Copy this file to .env and fill in values

# ═══════════════════ Deployment ═══════════════════

# Private key for deploying contracts (NO 0x prefix)
PRIVATE_KEY=

# Coston2 RPC URL (default: https://coston2-api.flare.network/ext/C/rpc)
COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc

# ═══════════════════ Contract Addresses (Coston2) ═══════════════════

# FXRP token (6 decimals) — default Coston2 address
FXRP_ADDRESS=0x0b6A3645c240605887a5532109323A3E12273dc7

# USDT0 token (6 decimals) — default Coston2 address
USDT0_ADDRESS=0x479854495cefBc8D12B971A3Ec4d18E6dbcE81a3

# TEE authority address (signs eligibility attestations)
TEE_AUTHORITY=

# FTSOv2 price feed address for XRP/USD (verified via ContractRegistry 2026-08-05)
FTSO_V2_ADDRESS=0xC4e9c78EA53db782E28f28Fdf80BaF59336B304d

# FDC Verification contract — default Coston2 address
FDC_VERIFICATION_ADDRESS=0x906507E0B64bcD494Db73bd0459d1C667e14B933

# ═══════════════════ Protocol Parameters ═══════════════════

# Collateral ratio in basis points (15000 = 150%)
COLLATERAL_RATIO_BPS=15000

# FTSO staleness limit in seconds (300 = 5 minutes)
FTSO_STALENESS_LIMIT=300

# Loan duration in seconds (604800 = 7 days)
LOAN_DURATION=604800

# ═══════════════════ Frontend ═══════════════════

# Contract address after deployment (fill after deploying)
NEXT_PUBLIC_VAULT_ADDRESS=

# Chain ID (114 for Coston2)
NEXT_PUBLIC_CHAIN_ID=114

# RPC URL for frontend
NEXT_PUBLIC_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
